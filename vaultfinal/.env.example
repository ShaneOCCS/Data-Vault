# Copy to .env for local development. NEVER commit a real .env file.
# See internal/config/config.go for full validation rules.

# HTTP port the server listens on.
PORT=8080

# "development" or "production". In production, USE_KMS must be true —
# config.Load() refuses to start otherwise (invariant #8).
APP_ENV=development

# postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://vaultapp:changeme@localhost:5432/vaultfinal

# Base64-encoded, must decode to >=32 bytes. Signs both member and admin
# session JWTs. Generate one with: openssl rand -base64 32
SESSION_KEY=

# Set to true in production. When true, KMS_KEY_ID is required and
# LOCAL_ENCRYPTION_KEY is ignored.
USE_KMS=false

# Required when USE_KMS=false. Base64-encoded, must decode to exactly 32
# bytes. Dev/synthetic data only — never use this in front of real
# patient data. Generate one with: openssl rand -base64 32
LOCAL_ENCRYPTION_KEY=

# Required when USE_KMS=true. ARN or alias of the KMS CMK used for
# envelope encryption.
KMS_KEY_ID=

# Label shown in a member's authenticator app next to their KIT ID.
TOTP_ISSUER=Medical Vault

# Comma-separated CORS allowlist for a frontend served from a different
# origin than the API. Each entry is a bare origin (scheme://host[:port])
# with no trailing slash. Leave empty for a same-origin deployment where
# nginx serves the frontend and the API from one vhost. "*" is rejected —
# this API authenticates with cookies. In production, https is required.
CORS_ALLOWED_ORIGINS=http://localhost:5173