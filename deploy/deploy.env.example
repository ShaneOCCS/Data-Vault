# Settings for the deploy scripts in deploy/scripts/.
#
# Copy this file to deploy/deploy.env and fill it in:
#     cp deploy/deploy.env.example deploy/deploy.env
#
# Nothing here is a password, but it does describe your server, so don't
# commit deploy.env to git.

# The Elastic IP of your EC2 instance (EC2 console -> Elastic IPs).
EC2_HOST=203.0.113.10

# The Linux user you SSH in as. On Amazon Linux 2023 this is ec2-user.
SSH_USER=ec2-user

# Path to the .pem key you use to SSH into the instance.
SSH_KEY=~/.ssh/vault-key.pem

# An existing admin account. The smoke test logs in with it
# (it asks for the password when it runs; the password is never stored).
ADMIN_EMAIL=you@example.com

# Optional: the user that owns the database tables (usually the RDS master
# user). If empty, step 2 asks for it.
DB_OWNER=

# Optional: your RDS instance identifier (RDS console -> Databases).
# If set, and the AWS CLI is installed and configured on this computer,
# step 1 takes the database snapshot for you. Otherwise it tells you how
# to do it in the console.
RDS_INSTANCE_ID=
